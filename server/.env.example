# 이 파일을 복사해서 `.env`로 만들고, 실제 키 값을 채우세요. (`.env`는 git에 올라가지 않습니다)
# read-only API 키를 권장합니다 (거래/출금 권한 없이 조회만).

# 어느 거래소를 쓸지. binance | bybit (기본값: binance)
# 체결 조회와 캔들 조회가 모두 이 값을 따라갑니다.
EXCHANGE=binance

# 바이낸스 키 (EXCHANGE=binance 일 때 사용)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# 바이비트 키 (EXCHANGE=bybit 일 때 사용)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# /trades 를 가짜 데이터로 돌릴지 여부. true=가짜(기본), false=진짜 거래소 호출.
USE_MOCK=true
